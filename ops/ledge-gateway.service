[Unit]
Description=LEDGE RPC gateway (gateway/server.mjs) -- every chain read goes through here
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ledge
Group=ledge
EnvironmentFile=/etc/ledge/gateway.env
ExecStart=/usr/bin/node /home/ledge/ledge/gateway/server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
